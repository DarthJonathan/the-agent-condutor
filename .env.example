# Local development only. Generate these two values; never reuse expense_tracker credentials.
POSTGRES_PASSWORD=
SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:3005
DEVELOPMENT=true
ALLOW_SIGNUP=true
WEB_PORT=3005
# Hosted deployment: PUBLIC_ORIGIN=https://your.domain, DEVELOPMENT=false, ALLOW_SIGNUP=false
# Set ALLOW_SIGNUP=true to enable registration over HTTPS in production too.
CONDUCTOR_DOMAIN=your.domain

# Optional hosted deployment using the images published by GitHub Actions.
# Set COMPOSE_FILE only on the server; leave local development builds unchanged.
# COMPOSE_FILE=docker-compose.yml:deploy/compose.ghcr.yml
CONDUCTOR_IMAGE_PREFIX=ghcr.io/darthjonathan/the-agent-condutor
CONDUCTOR_IMAGE_TAG=latest
